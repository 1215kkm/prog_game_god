{
    "name": "god-simulation",
    "version": "0.1.0",
    "description": "신의 손길 - 하늘에서 바라보는 문명 시뮬레이션 게임",
    "type": "module",
    "main": "electron/main.js",
    "scripts": {
        "start": "python3 -m http.server 8080",
        "electron": "electron .",
        "build:win": "electron-builder --win",
        "build:mac": "electron-builder --mac",
        "build:linux": "electron-builder --linux"
    },
    "build": {
        "appId": "com.godsimulation.app",
        "productName": "신의 손길",
        "files": [
            "index.html",
            "style.css",
            "manifest.json",
            "src/**/*",
            "electron/**/*",
            "icon-*.png"
        ],
        "win": {
            "target": "nsis",
            "icon": "icon-512.png"
        },
        "mac": {
            "target": "dmg",
            "icon": "icon-512.png"
        },
        "linux": {
            "target": "AppImage",
            "icon": "icon-512.png"
        }
    },
    "devDependencies": {
        "electron": "^33.0.0",
        "electron-builder": "^25.0.0"
    }
}
